{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZScribe",
  "version": "0.1.0",
  "identifier": "dev.theholyonez.zscribe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZScribe",
        "url": "index.html",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "visible": true,
        "theme": null,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "recorder",
        "title": "ZScribe \u2014 recording",
        "url": "recorder.html",
        "width": 384,
        "height": 104,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "player",
        "title": "ZScribe \u2014 player",
        "url": "player.html",
        "width": 560,
        "height": 780,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TheHolyOneZ",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright \u00a9 2026 TheHolyOneZ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local meeting and note recorder",
    "longDescription": "Press a hotkey, talk, press again \u2014 ZScribe gives you a transcript, a structured summary and action items. Transcription runs locally with Whisper and never touches the network. Summaries use a local Ollama model, or Gemini or any OpenAI-compatible endpoint if you choose one.",
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1"
        ]
      },
      "rpm": {
        "depends": [
          "vulkan-loader"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
