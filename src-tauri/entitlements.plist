<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only when the macOS build is signed. Inert otherwise, and here now
  because the day it starts mattering is the day somebody notarises a release
  and cannot work out why the microphone went silent: the hardened runtime
  blocks audio input unless this entitlement is present, and the failure looks
  like a bug in the app rather than a missing line of XML.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- whisper.cpp is compiled ahead of time and loads no plugins, but the
         Metal backend builds its shader pipeline at runtime, which the
         hardened runtime treats as JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
